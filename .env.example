# CineAgent Environment Configuration
# Copy this file to .env and fill in your API keys

# TMDB API Key (free tier)
# Get yours at: https://developer.themoviedb.org/docs/getting-started
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key (free tier)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB persistence directory (default: ./data/indices)
CHROMA_PERSIST_DIR=./data/indices

# Optional: Ollama base URL (if using local LLM instead of Gemini)
# OLLAMA_BASE_URL=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
